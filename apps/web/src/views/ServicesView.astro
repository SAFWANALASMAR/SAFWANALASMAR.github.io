---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardMarquee from '../components/CardMarquee.astro';
import { getServices, getSite, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const services = await getServices();
---

<Base
  lang={lang}
  path="/services/"
  title={t.meta.pages.services.title}
  description={t.meta.pages.services.description}
>
  <section class="container-x pt-14 sm:pt-20">
    <SectionHeading as="h1" icon="briefcase" title={t.services.title} intro={t.services.intro} />
  </section>
  <CardMarquee label={t.services.title} dir={lang === 'ar' ? 'rtl' : 'ltr'} repeat={3}>
    {
      services.map((service) => (
        <li class="cm-item cm-chip">
          <a href={`#${service.id}`} class="chip-link">
            <span class="icon-badge size-8 rounded-lg">
              <Icon name={service.data.icon} size={16} />
            </span>
            {service.data[lang].title}
          </a>
        </li>
      ))
    }
  </CardMarquee>
  <section class="container-x">
    <div class="mt-6 space-y-8">
      {
        services.map((service, i) => {
          const st = service.data[lang];
          return (
            <article
              id={service.id}
              class:list={['card card-hover service-row reveal scroll-mt-28', i % 2 ? 'from-end' : 'from-start']}
            >
              <div class:list={['service-art', { 'is-flipped': i % 2 }]} aria-hidden="true">
                <span class="service-num" dir="ltr">{String(i + 1).padStart(2, '0')}</span>
                <span class="service-art-icon">
                  <Icon name={service.data.icon} size={44} />
                </span>
              </div>
              <div class="service-body p-6 sm:p-8">
              <div class="flex items-start gap-4">
                <span class="icon-badge size-12 rounded-xl">
                  <Icon name={service.data.icon} size={24} />
                </span>
                <div>
                  <h2 class="text-2xl leading-snug font-bold text-text">{st.title}</h2>
                  <p class="mt-2 text-muted">{st.summary}</p>
                </div>
              </div>

              <dl class="mt-6 flex-1 space-y-5">
                <div>
                  <dt class="eyebrow">{t.services.audienceLabel}</dt>
                  <dd class="mt-1 text-text">{st.audience}</dd>
                </div>
                <div>
                  <dt class="eyebrow">{t.services.includesLabel}</dt>
                  <dd>
                    <ul class="mt-2 space-y-2">
                      {st.includes.map((item) => (
                        <li class="flex gap-2.5 text-text">
                          <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>

              <div class="mt-8">
                <a
                  href={`${localePath(lang, '/request/')}?service=${service.id}`}
                  class="btn btn-primary"
                >
                  {t.services.request}
                  <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
                </a>
              </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="reveal mt-10 text-center text-sm text-muted">{t.services.pricing}</p>
  </section>
</Base>
