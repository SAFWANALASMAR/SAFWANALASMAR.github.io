---
// Printable one-language CV built from the same content as the site (no phone number by design).
// Turned into PDFs by scripts/generate-cv.mjs; the pages themselves are noindex.
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import QRCode from 'qrcode';
import { getSettings, getSite, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const a = t.about;
const ar = lang === 'ar';
const L = ar
  ? { exp: 'الخبرات', edu: 'التعليم والشهادات', mkt: 'مشاريع التسويق', skills: 'المهارات', vol: 'العمل التطوعي', profile: 'نبذة' }
  : { exp: 'Experience', edu: 'Education and certificates', mkt: 'Marketing projects', skills: 'Skills', vol: 'Volunteering', profile: 'Profile' };
const site = new URL(ar ? '/' : '/en/', Astro.site).href.replace(/\/$/, '');
// A scannable code on the printed CV that opens the site in the CV's language.
const qr = await QRCode.toString(`${site}/`, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#10232a', light: '#ffffff' } });
// Paid roles go under experience; unpaid ones (flagged in the content) under volunteering.
const jobs = a.timeline.filter((item) => !item.volunteer);
const volunteerRoles = a.timeline.filter((item) => item.volunteer);
const qrLabel = ar ? 'امسح لفتح الموقع' : 'Scan to open the site';
---

<!doctype html>
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{t.hero.name} — CV</title>
  </head>
  <body>
    <header>
      <div>
        <h1>{t.hero.name}</h1>
        <p class="role">{t.hero.title}</p>
        <p class="contact" dir="ltr">
          {s.email} · {s.linkedin.replace(/^https?:\/\/(www\.)?/, '')} · {s.github.replace(/^https?:\/\//, '')} · {site.replace(/^https?:\/\//, '')}
        </p>
      </div>
      <div class="qr">
        <Fragment set:html={qr} />
        <span>{qrLabel}</span>
      </div>
    </header>

    <section>
      <h2>{L.profile}</h2>
      <p>{a.bio}</p>
    </section>

    <section>
      <h2>{L.exp}</h2>
      {
        jobs.map((item) => (
          <div class="item">
            <div class="row">
              <strong>{item.org}</strong>
              <span class="date">{item.period}</span>
            </div>
            <p class="sub">{item.role}</p>
            {item.points && (
              <ul>
                {item.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="page-break">
      <h2>{L.edu}</h2>
      {
        a.education.map((e) => (
          <div class="row item">
            <span>
              <strong>{e.title}</strong>
              {e.org && <span class="sub"> — <bdi>{e.org}</bdi></span>}
            </span>
            <span class="date">{e.date}</span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{L.vol}</h2>
      {
        volunteerRoles.map((item) => (
          <div class="item">
            <div class="row">
              <strong>{item.org}</strong>
              <span class="date">{item.period}</span>
            </div>
            <p class="sub">{item.role}</p>
            {item.points && (
              <ul>
                {item.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      {
        a.volunteer.map((v) => (
          <div class="row item">
            <span>
              <strong>{v.title}</strong>
            </span>
            <span class="date">{v.period}</span>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{L.mkt}</h2>
      {
        a.marketing.projects.map((p) => (
          <div class="row item">
            <span>
              <strong>{p.name}</strong> <span class="sub">— {p.role}</span>
            </span>
            <span class="date">{p.period}</span>
          </div>
        ))
      }
    </section>

    <section class="two">
      <div>
        <h2>{L.skills}</h2>
        {
          a.skills.map((g) => (
            <p class="skill">
              <strong>{g.category}:</strong> <bdi>{g.items.join(' · ')}</bdi>
            </p>
          ))
        }
      </div>
      <div>
        <h2>{a.languagesTitle}</h2>
        {
          a.languages.map((l) => (
            <p class="skill">
              <strong>{l.name}:</strong> {l.level}
            </p>
          ))
        }
      </div>
    </section>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 11mm 13mm;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
    font-size: 9.6pt;
    line-height: 1.45;
    color: #10232a;
  }
  header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    border-bottom: 3px solid #0b7285;
    padding-bottom: 8px;
    margin-bottom: 10px;
  }
  .qr {
    flex-shrink: 0;
    width: 17mm;
    text-align: center;
    font-size: 6pt;
    line-height: 1.3;
    color: #44606a;
  }
  .qr svg {
    display: block;
    width: 17mm;
    height: 17mm;
    margin-bottom: 1.5px;
  }
  h1 {
    margin: 0;
    font-size: 22pt;
    color: #0b7285;
  }
  .role {
    margin: 2px 0 0;
    font-weight: 700;
    color: #8a6a0c;
    font-size: 11pt;
  }
  .contact {
    margin: 4px 0 0;
    font-size: 9pt;
    color: #46606a;
  }
  h2 {
    margin: 9px 0 5px;
    font-size: 11.5pt;
    color: #0b7285;
    border-bottom: 1px solid #c9a227;
    padding-bottom: 2px;
  }
  p {
    margin: 0;
  }
  .item {
    margin-bottom: 4px;
    break-inside: avoid;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .date {
    color: #8a6a0c;
    white-space: nowrap;
    font-size: 9pt;
  }
  .sub {
    color: #46606a;
  }
  ul {
    margin: 2px 0 0;
    padding-inline-start: 16px;
  }
  .page-break {
    break-before: page;
  }
  .page-break h2 {
    margin-top: 0;
  }
  .two {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 18px;
  }
  .skill {
    margin-bottom: 3px;
  }
</style>
