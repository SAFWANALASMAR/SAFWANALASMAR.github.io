---
import Tag from '../components/Tag.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CardMarquee from '../components/CardMarquee.astro';
import { skillIcon } from '../lib/skillIcons';
import { getSettings, getSite, publicFileExists, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const a = t.about;
const hasPhoto = publicFileExists(s.photo);
const photoWebp = s.photo.replace(/\.jpe?g$/i, '.webp');
const hasWebp = photoWebp !== s.photo && publicFileExists(photoWebp);
const r = a.reviews;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<Base
  lang={lang}
  path="/about/"
  title={t.meta.pages.about.title}
  description={t.meta.pages.about.description}
>
  <section class="container-x pt-14 sm:pt-20">
    <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
      {
        hasPhoto ? (
          <picture class="photo-ring shadow-soft">
            {hasWebp && <source srcset={url(photoWebp)} type="image/webp" />}
            <img
              src={url(s.photo)}
              alt={a.photoAlt}
              width="176"
              height="176"
              decoding="async"
              class="size-36 object-cover sm:size-44"
            />
          </picture>
        ) : (
          <div
            class="grid size-36 place-items-center rounded-full bg-accent text-4xl font-bold text-on-accent shadow-soft sm:size-44 sm:text-5xl"
            role="img"
            aria-label={a.photoAlt}
          >
            <span aria-hidden="true">{a.initials}</span>
          </div>
        )
      }
      <div class="max-w-3xl">
        <SectionTitle as="h1" icon="user" title={a.title} />
        <p class="mt-5 text-lg text-text">{a.bio}</p>
      </div>
    </div>
  </section>

  <div class="container-x mt-16 grid gap-16 lg:grid-cols-2">
    <!-- Timeline -->
    <section aria-labelledby="timeline">
      <SectionTitle id="timeline" icon="briefcase" size="md" title={a.timelineTitle} />
      <ol class="stagger mt-8 space-y-8 border-s-2 border-line ps-8">
        {
          a.timeline.map((item) => (
            <li class="reveal relative">
              <span class="icon-badge absolute -start-[3.15rem] top-0 size-9 bg-surface">
                <Icon name={item.icon ?? 'briefcase'} size={18} />
              </span>
              <p class="text-sm font-medium text-accent">{item.period}</p>
              <h3 class="mt-1 font-bold text-text">{item.org}</h3>
              <p class="mt-1 text-sm text-muted">{item.role}</p>
              {item.points && (
                <ul class="mt-3 space-y-1.5 text-sm text-text">
                  {item.points.slice(0, 2).map((point) => (
                    <li class="flex gap-2">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}
              {item.points && item.points.length > 2 && (
                <details class="more mt-2">
                  <summary>{a.showMore}</summary>
                  <ul class="mt-2 space-y-1.5 text-sm text-text">
                    {item.points.slice(2).map((point) => (
                      <li class="flex gap-2">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {item.link && (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="visit-btn mt-4"
                >
                  {item.linkLabel ?? item.link}
                  <Icon name="external" size={14} />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <div class="space-y-16">
      <!-- Volunteering -->
      <section aria-labelledby="volunteer">
        <SectionTitle id="volunteer" icon="heart" size="md" title={a.volunteerTitle} />
        <ul class="stagger mt-6 space-y-3">
          {
            a.volunteer.map((v) => (
              <li class="card lift reveal flex items-center gap-4 p-4">
                <span class="icon-badge size-11 rounded-xl">
                  <Icon name={v.icon} size={22} />
                </span>
                <div class="min-w-0">
                  <p class="font-bold text-text">{v.title}</p>
                  <p class="mt-0.5 text-sm font-medium text-gold-text">{v.period}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Languages -->
      <section aria-labelledby="languages">
        <SectionTitle id="languages" icon="globe" size="md" title={a.languagesTitle} />
        <ul class="stagger mt-6 grid gap-3 sm:grid-cols-2">
          {
            a.languages.map((l) => (
              <li class="card lift reveal lang-card p-5">
                <p class="text-xl font-bold text-text">{l.name}</p>
                <p class="mt-1 text-sm font-semibold text-accent">{l.level}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <!-- Education -->
  <section class="mt-20" aria-labelledby="education">
    <div class="container-x">
      <SectionTitle id="education" icon="cap" size="md" title={a.educationTitle} />
    </div>
    <CardMarquee label={a.educationTitle} dir={dir}>
      {
        a.education.map((item) => (
          <li class:list={['cm-item cm-edu card card-hover flex flex-col gap-3 p-5', item.highlight && 'edu-key']}>
            {item.highlight && (
              <span class="edu-ribbon">
                <Icon name="award" size={13} class="ico-still" />
                {a.highlightLabel}
              </span>
            )}
            <div class="flex items-center justify-between gap-3">
              <span class="icon-badge size-11 rounded-xl">
                <Icon name={item.icon ?? 'award'} size={22} />
              </span>
              <span class="chip text-xs font-semibold">{item.date}</span>
            </div>
            <h3 class="font-bold leading-snug text-text">{item.title}</h3>
            {item.org && <p class="text-sm text-muted">{item.org}</p>}
          </li>
        ))
      }
    </CardMarquee>
  </section>

  <!-- Marketing and sales -->
  <section class="container-x mt-20" aria-labelledby="marketing">
    <div class="reveal max-w-2xl">
      <SectionTitle id="marketing" icon="chart" size="md" title={a.marketing.title} />
      <p class="mt-4 text-muted">{a.marketing.intro}</p>
    </div>
  </section>
  <CardMarquee label={a.marketing.title} dir={dir} reverse repeat={3}>
    {
      a.marketing.projects.map((pr) => (
        <li class="cm-item cm-mkt card card-hover project-card relative flex flex-col p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="icon-badge size-11 rounded-xl">
              <Icon name={pr.icon} size={22} />
            </span>
            <span class="chip text-xs font-semibold">{pr.period}</span>
          </div>
          <h3 class="mt-5 text-lg leading-snug font-bold text-text">{pr.name}</h3>
          <p class="mt-1.5 text-sm text-muted">{pr.role}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-text">
            {pr.points.map((point) => (
              <li class="flex gap-2">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
          {pr.link && (
            <a href={pr.link} target="_blank" rel="noopener noreferrer" class="visit-btn mt-auto self-start">
              <Icon name="external" size={16} />
              {t.projects.visit}
              <span class="visit-domain" dir="ltr">{pr.link.replace(/^https?:\/\/|\/$/g, '')}</span>
            </a>
          )}
        </li>
      ))
    }
  </CardMarquee>
  <section class="container-x" aria-label={a.marketing.certsTitle}>
    <h3 class="mt-10 font-bold text-text">{a.marketing.certsTitle}</h3>
    <ul class="stagger mt-4 grid gap-3 md:grid-cols-3">
      {
        a.marketing.certs.map((cert) => (
          <li class="card lift reveal flex items-start gap-3 p-4">
            <span class="icon-badge size-10">
              <Icon name="award" size={20} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-text">{cert.title}</p>
              <p class="mt-0.5 text-sm text-muted">
                <bdi>{cert.org}</bdi>
                {cert.note && <> · {cert.note}</>}
              </p>
            </div>
            <span class="shrink-0 text-sm font-medium text-gold-text">{cert.date}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Student reviews -->
  <section class="container-x mt-20" aria-labelledby="reviews">
    <div class="card overflow-hidden">
      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_1.6fr]">
        <div>
          <SectionTitle id="reviews" icon="star" size="md" title={r.title} />
          <p class="mt-4 text-muted">{r.intro}</p>
          <dl class="mt-6 grid grid-cols-2 gap-4">
            {
              r.stats.map((st) => (
                <div class="glass-soft flex flex-col-reverse rounded-xl p-4">
                  <dt class="text-sm text-muted">{st.label}</dt>
                  <dd class="text-2xl font-bold text-accent">
                    <bdi dir="ltr" data-count={st.value}>{st.value}</bdi>
                  </dd>
                </div>
              ))
            }
          </dl>
          <a
            href={r.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary mt-6"
          >
            {r.more}
            <Icon name="external" size={16} />
          </a>
        </div>
        <div class="rev-carousel" data-rev-carousel aria-roledescription="carousel" aria-label={r.title}>
          <ul class="rev-track">
            {
              r.items.map((rev, i) => (
                <li class:list={['rev-slide glass-soft rounded-2xl border border-line p-6 sm:p-8', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
                  <div class="flex items-center justify-between">
                    <p class="text-lg tracking-widest text-gold" aria-hidden="true">★★★★★</p>
                    <Icon name="quote" size={30} class="text-accent/40" />
                  </div>
                  <p class="mt-4 text-lg leading-relaxed text-text sm:text-xl">{rev.text}</p>
                  <p class="mt-5 text-sm font-semibold text-muted">
                    <bdi>{rev.name}</bdi> · {rev.date}
                  </p>
                </li>
              ))
            }
          </ul>
          <div class="mt-4 flex items-center justify-center" data-rev-dots>
            {r.items.map((_, i) => <button type="button" class:list={['rev-dot', { 'is-active': i === 0 }]} aria-label={`${i + 1} / ${r.items.length}`} data-rev-dot={i} />)}
          </div>
        </div>
      </div>
      <p class="band-glass border-t border-line px-6 py-3 text-xs text-muted sm:px-8">{r.note}</p>
    </div>
  </section>

  <dialog class="lightbox" id="cert-dialog" aria-label={a.certificateView}>
    <form method="dialog" class="flex justify-end p-2">
      <button class="btn btn-ghost min-h-0 px-3 py-1 text-sm">{a.certificateClose}</button>
    </form>
    <img id="cert-img" alt="" class="block h-auto max-h-[80vh] w-full object-contain" />
  </dialog>

  <!-- Skills -->
  <section class="container-x mt-16" aria-labelledby="skills">
    <SectionTitle id="skills" icon="code" size="md" title={a.skillsTitle} />
  </section>
  <CardMarquee label={a.skillsTitle} dir={dir} speed="slow">
    {
      a.skills.map((group) => (
        <li class="cm-item cm-skill card card-hover p-6">
          <h3 class="flex items-center gap-3 font-bold text-text">
            <span class="icon-badge size-10 rounded-xl">
              <Icon name={skillIcon(group.items[0] ?? group.category)} size={20} />
            </span>
            {group.category}
          </h3>
          <ul class="skill-tags mt-4 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <Tag text={item} />
            ))}
          </ul>
        </li>
      ))
    }
  </CardMarquee>
</Base>

<script>
  // Reviews carousel: one review at a time, next every 6 s; dots jump; pauses while hovered or focused.
  const carousel = document.querySelector<HTMLElement>('[data-rev-carousel]');
  if (carousel) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('.rev-slide')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-rev-dot]')];
    let current = 0;
    let paused = false;
    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((el, i) => {
        el.classList.toggle('is-active', i === current);
        if (i === current) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    carousel.addEventListener('mouseenter', () => (paused = true));
    carousel.addEventListener('mouseleave', () => (paused = false));
    carousel.addEventListener('focusin', () => (paused = true));
    carousel.addEventListener('focusout', () => (paused = false));
    setInterval(() => {
      if (!paused && !document.hidden) show(current + 1);
    }, 6000);
  }

  // Open a certificate image in the dialog; Escape or the close button dismisses it.
  const dialog = document.querySelector<HTMLDialogElement>('#cert-dialog');
  const img = document.querySelector<HTMLImageElement>('#cert-img');
  document.querySelectorAll<HTMLButtonElement>('[data-cert]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !img) return;
      img.src = button.dataset.cert ?? '';
      img.alt = button.dataset.certAlt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
