---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getSettings, getSite, isPlaceholder, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const p = t.privacy;
// Same switch as the forms: with a Turnstile key they send directly, otherwise they open the visitor's email app.
const siteKey: string = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || s.turnstileSiteKey;
const direct = !isPlaceholder(siteKey);
---

<Base lang={lang} path="/privacy/" title={t.meta.pages.privacy.title} description={t.meta.pages.privacy.description}>
  <section class="container-x pt-14 sm:pt-20">
    <SectionHeading as="h1" icon="shield" title={p.title} intro={p.intro} />
    <p class="mt-3 text-sm text-muted">{p.updated}</p>
  </section>
  <section class="container-x mt-10">
    <div class="grid max-w-4xl gap-4">
      {
        p.sections.map((section) => (
          <article class="card reveal p-6">
            <h2 class="flex items-center gap-3 text-lg font-bold text-text">
              <span class="icon-badge size-10 rounded-xl">
                <Icon name={section.icon} size={20} />
              </span>
              {section.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {((direct && section.pointsDirect) || section.points).map((point) => (
                <li class="flex gap-2.5 text-text">
                  <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="reveal mt-8 flex max-w-4xl flex-wrap items-center gap-3 text-text">
      {p.contactText}
      <a href={localePath(lang, '/contact/')} class="more-pill">
        {p.contactCta}
        <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
      </a>
    </p>
  </section>
</Base>
