---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {
  emailParts,
  getServices,
  getSettings,
  getSite,
  isPlaceholder,
  publicFileExists,
  url,
  type Lang,
} from '../lib/i18n';
import { CONTACT_LIMITS, CONTACT_PATH } from '@safwan/shared';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const c = t.contact;
const services = await getServices();

// PUBLIC_TURNSTILE_SITE_KEY overrides settings.yaml for local runs and tests (e.g. Cloudflare's test key).
const siteKey: string = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || s.turnstileSiteKey;
const formReady = !isPlaceholder(siteKey);
const emailReady = !isPlaceholder(s.email);
// Until the Turnstile key is set, the form opens the visitor's email app with the message filled in.
const useMailto = !formReady && emailReady;
const githubReady = !isPlaceholder(s.github);
const cvPath = s.cv[lang];
const hasCv = publicFileExists(cvPath);
const mail = emailParts(s.email);

const linkClass =
  'flex items-center gap-3 glass-soft rounded-xl border border-line p-4 text-text transition-colors hover:border-accent hover:text-accent';
---

<Base
  lang={lang}
  path="/contact/"
  title={t.meta.pages.contact.title}
  description={t.meta.pages.contact.description}
>
  <section class="container-x pt-14 sm:pt-20">
    <SectionHeading as="h1" icon="mail" title={c.title} intro={c.intro} />

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <!-- Form -->
      <div id="contact-form" class="card scroll-mt-24 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-text">{c.formTitle}</h2>
        {
          useMailto ? (
            <p class="mt-2 text-sm text-muted">{c.formMailto}</p>
          ) : (
            !formReady && (
              <p class="mt-4 rounded-lg border border-line bg-surface-2 p-3 text-sm text-text" role="note">
                {c.formNotReady}
              </p>
            )
          )
        }
        <form
          class="mt-6 space-y-5"
          method="POST"
          action={formReady ? CONTACT_PATH : undefined}
          data-api={formReady ? '' : undefined}
          data-lang={lang}
          data-status-text={formReady ? JSON.stringify(c.status) : undefined}
          enctype={useMailto ? 'text/plain' : undefined}
          data-mailto={useMailto ? '' : undefined}
          data-u={useMailto ? mail.u : undefined}
          data-d={useMailto ? mail.d : undefined}
          data-labels={JSON.stringify({ name: c.name, email: c.email, service: c.service })}
        >
          <input type="hidden" name="_subject" value={c.subject} />
          <input type="hidden" name="_language" value={lang} />
          <!-- Honeypot: hidden from people and screen readers; bots tend to fill it. -->
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-text">{c.name}</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                minlength={CONTACT_LIMITS.name.min}
                maxlength={CONTACT_LIMITS.name.max}
                autocomplete="name"
                class="field"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-text">{c.email}</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength={CONTACT_LIMITS.email.max}
                autocomplete="email"
                dir="ltr"
                class="field"
              />
            </div>
          </div>
          <div>
            <label for="service" class="mb-1.5 block text-sm font-medium text-text">{c.service}</label>
            <select id="service" name="service" required class="field">
              <option value="" disabled selected>{c.servicePlaceholder}</option>
              {services.map((service) => <option value={service.id}>{service.data[lang].title}</option>)}
              {c.extraServices.map((extra) => <option value={extra.id}>{extra.label}</option>)}
              <option value="other">{c.serviceOther}</option>
            </select>
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-text">{c.message}</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              minlength={CONTACT_LIMITS.message.min}
              maxlength={CONTACT_LIMITS.message.max}
              class="field resize-y"></textarea>
          </div>
          {
            formReady && (
              <div
                class="cf-turnstile"
                data-sitekey={siteKey}
                data-action="contact"
                data-language={lang}
                data-theme="auto"
                data-size="flexible"
              />
            )
          }
          <button type="submit" class="btn btn-primary w-full sm:w-auto" disabled={!formReady && !useMailto}>
            {c.submit}
            <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
          </button>
          <p data-status role="status" aria-live="polite" class="text-sm font-medium empty:hidden"></p>
        </form>
      </div>

      <!-- Direct links -->
      <aside aria-labelledby="direct">
        <h2 id="direct" class="text-xl font-bold text-text">{c.directTitle}</h2>
        <ul class="mt-6 space-y-3">
          <li>
            {
              emailReady ? (
                <a href="#" data-u={mail.u} data-d={mail.d} class={linkClass}>
                  <Icon name="mail" />
                  <span class="shrink-0 text-sm whitespace-nowrap text-muted">{c.emailLabel}</span>
                  <span class="ms-auto min-w-0 truncate font-medium" dir="ltr" data-email-text>
                    {mail.masked}
                  </span>
                </a>
              ) : (
                <div class={linkClass}>
                  <Icon name="mail" />
                  <span class="shrink-0 text-sm whitespace-nowrap text-muted">{c.emailLabel}</span>
                  <span class="ms-auto font-medium">{s.email}</span>
                </div>
              )
            }
          </li>
          <li>
            <a href={s.linkedin} target="_blank" rel="me noopener noreferrer" class={linkClass}>
              <Icon name="linkedin" />
              <span class="shrink-0 text-sm whitespace-nowrap text-muted">{c.linkedinLabel}</span>
              <span class="ms-auto truncate font-medium" dir="ltr">in/safwan-alasmar</span>
            </a>
          </li>
          <li>
            {
              githubReady ? (
                <a href={s.github} target="_blank" rel="me noopener noreferrer" class={linkClass}>
                  <Icon name="github" />
                  <span class="shrink-0 text-sm whitespace-nowrap text-muted">{c.githubLabel}</span>
                  <span class="ms-auto truncate font-medium" dir="ltr">
                    {s.github.replace(/^https?:\/\/(www\.)?github\.com\//, '')}
                  </span>
                </a>
              ) : (
                <div class={linkClass}>
                  <Icon name="github" />
                  <span class="shrink-0 text-sm whitespace-nowrap text-muted">{c.githubLabel}</span>
                  <span class="ms-auto font-medium">{s.github}</span>
                </div>
              )
            }
          </li>
        </ul>

        <div class="mt-6">
          {
            hasCv ? (
              <a href={url(cvPath)} download class="btn btn-ghost w-full">
                <Icon name="download" size={18} />
                {c.cv}
              </a>
            ) : (
              <p class="btn btn-ghost w-full cursor-not-allowed opacity-80" aria-disabled="true">
                <Icon name="download" size={18} />
                {c.cv} <span class="text-sm text-muted">{c.cvPending}</span>
              </p>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</Base>

{formReady && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Mailto mode: open the visitor's email app with subject and message prefilled.
  const form = document.querySelector<HTMLFormElement>('form[data-mailto]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const labels = JSON.parse(form.dataset.labels ?? '{}');
    const select = form.querySelector<HTMLSelectElement>('#service');
    const service = select?.selectedOptions[0]?.text ?? '';
    const body = [
      `${labels.name}: ${data.get('name')}`,
      `${labels.email}: ${data.get('email')}`,
      `${labels.service}: ${service}`,
      '',
      String(data.get('message') ?? ''),
    ].join('\n');
    const subject = `${data.get('_subject')} — ${service}`;
    location.href = `mailto:${form.dataset.u}@${form.dataset.d}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  // API mode: send JSON to the site's own API (Turnstile token included) and show the result inline.
  type Turnstile = { reset: (widget?: string) => void };
  const apiForm = document.querySelector<HTMLFormElement>('form[data-api]');
  apiForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const text: Record<string, string> = JSON.parse(apiForm.dataset.statusText ?? '{}');
    const status = apiForm.querySelector<HTMLElement>('[data-status]')!;
    const button = apiForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const show = (key: string, ok = false) => {
      status.textContent = text[key] ?? text.unavailable ?? '';
      status.classList.toggle('text-accent', ok);
      status.classList.toggle('text-danger', !ok && key !== 'sending');
    };

    const data = new FormData(apiForm);
    const token = String(data.get('cf-turnstile-response') ?? '');
    if (!token) return show('captcha');

    button.disabled = true;
    show('sending');
    try {
      const res = await fetch(apiForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          service: data.get('service'),
          message: data.get('message'),
          website: data.get('website'),
          lang: apiForm.dataset.lang,
          turnstileToken: token,
        }),
      });
      const result = await res.json().catch(() => ({ ok: false, error: 'unavailable' }));
      if (result.ok) {
        apiForm.reset();
        show('sent', true);
      } else {
        show(result.error);
      }
    } catch {
      show('unavailable');
    } finally {
      button.disabled = false;
      (window as unknown as { turnstile?: Turnstile }).turnstile?.reset();
    }
  });

  // Preselect the service when arriving from "Request this service".
  const service = new URLSearchParams(location.search).get('service');
  const select = document.querySelector<HTMLSelectElement>('#service');
  if (service && select && [...select.options].some((o) => o.value === service)) {
    select.value = service;
  }
</script>
