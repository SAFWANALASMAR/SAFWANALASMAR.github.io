---
import Tag from '../components/Tag.astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getSite, localePath, publicFileExists, toList, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}

const { lang, project } = Astro.props;
const t = await getSite(lang);
const p = project.data;
const text = p[lang];
const L = t.projects.labels;

// Case-study sections in template order; empty ones are skipped.
const sections = [
  { label: L.challenge, items: toList(text.challenge) },
  { label: L.solution, items: toList(text.solution) },
  { label: L.role, items: toList(text.role) },
  { label: L.tools, items: toList(text.tools), asTags: true },
  { label: L.result, items: toList(text.result) },
  { label: L.availability, items: toList(text.availability) },
].filter((s) => s.items.length > 0);

const image = p.image && publicFileExists(p.image) ? p.image : undefined;
const imageSmall = image?.replace(/\.webp$/, '-778.webp');
const hasSmall = !!imageSmall && imageSmall !== image && publicFileExists(imageSmall);
const domain = p.link?.replace(/^https?:\/\/|\/$/g, '');
const abs = (path: string) => new URL(path, Astro.site).href;
const pageUrl = abs(localePath(lang, `/projects/${project.id}/`));
// Tells search engines what this page is: a piece of work by this person, and where it sits in the site.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      name: text.title,
      description: text.summary,
      url: pageUrl,
      inLanguage: lang,
      dateCreated: String(p.year),
      keywords: p.tags.join(', '),
      author: { '@type': 'Person', name: t.hero.name, url: abs(localePath(lang, '/')) },
      ...(text.org ? { sourceOrganization: { '@type': 'Organization', name: text.org } } : {}),
      ...(p.link ? { sameAs: p.link } : {}),
      ...(image ? { image: abs(url(image)) } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.nav.home, item: abs(localePath(lang, '/')) },
        { '@type': 'ListItem', position: 2, name: t.nav.projects, item: abs(localePath(lang, '/projects/')) },
        { '@type': 'ListItem', position: 3, name: text.title, item: pageUrl },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  path={`/projects/${project.id}/`}
  title={`${text.title} — ${t.meta.siteName}`}
  description={text.summary}
  jsonLd={jsonLd}
>
  <article class="container-x max-w-4xl pt-10 sm:pt-14">
    <a
      href={localePath(lang, '/projects/')}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:underline"
    >
      <Icon name="arrow" size={16} class="ltr:-scale-x-100" />
      {t.projects.back}
    </a>

    <header class="mt-6 border-b border-line pb-8">
      <h1 class="text-3xl leading-tight font-bold text-text sm:text-4xl">{text.title}</h1>
      <p class="mt-4 text-lg text-muted">{text.summary}</p>
      {
        p.link && (
          <a href={p.link} target="_blank" rel="noopener noreferrer" class="visit-btn visit-btn-lg mt-6">
            <Icon name="external" size={20} />
            {t.projects.visit}
            <span class="visit-domain" dir="ltr">{p.link.replace(/^https?:\/\/|\/$/g, '')}</span>
          </a>
        )
      }

      {
        image && (
          <figure class="browser-frame case-shot mt-8">
            <div class="browser-bar" aria-hidden="true">
              <span class="browser-dots"><i /><i /><i /></span>
              {domain && (
                <span class="browser-url" dir="ltr">
                  <Icon name="shield" size={12} />
                  {domain}
                </span>
              )}
            </div>
            <img
              src={url(image)}
              srcset={hasSmall ? `${url(imageSmall!)} 778w, ${url(image)} ${p.imageSize?.[0] ?? 1556}w` : undefined}
              sizes="(min-width: 56rem) 54rem, 92vw"
              alt={text.title}
              width={p.imageSize?.[0]}
              height={p.imageSize?.[1]}
              decoding="async"
            />
          </figure>
        )
      }

      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-muted">{L.year}</dt>
          <dd class="mt-0.5 font-semibold text-text" dir="ltr">{p.year}</dd>
        </div>
        <div>
          <dt class="text-muted">{L.type}</dt>
          <dd class="mt-0.5 font-semibold text-text">
            {t.projects.types[p.type]}
            {
              p.status === 'in-progress' && (
                <span class="ms-1 rounded-md bg-accent-soft px-2 py-0.5 text-xs text-accent">
                  {t.projects.inProgress}
                </span>
              )
            }
          </dd>
        </div>
        {
          text.org && (
            <div>
              <dt class="text-muted">{L.org}</dt>
              <dd class="mt-0.5 font-semibold text-text">{text.org}</dd>
            </div>
          )
        }
      </dl>

      <h2 class="sr-only">{L.tags}</h2>
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {p.tags.map((tag) => <Tag text={tag} />)}
      </ul>
    </header>

    <div class="divide-y divide-line">
      {
        sections.map((section) => (
          <section class="reveal grid gap-3 py-8 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <h2 class="eyebrow text-base">{section.label}</h2>
            {section.asTags ? (
              <ul class="flex flex-wrap gap-1.5">
                {section.items.map((tool) => (
                  <Tag text={tool} class="text-sm" />
                ))}
              </ul>
            ) : section.items.length === 1 ? (
              <p class="text-text">{section.items[0]}</p>
            ) : (
              <ul class="space-y-2.5">
                {section.items.map((item) => (
                  <li class="flex gap-2.5 text-text">
                    <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      {
        p.link && (
          <section class="reveal grid gap-3 py-8 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <h2 class="eyebrow text-base">{L.link}</h2>
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              class="visit-btn"
              dir="ltr"
            >
              {domain}
              <Icon name="external" size={16} />
            </a>
          </section>
        )
      }
    </div>
  </article>
</Base>
