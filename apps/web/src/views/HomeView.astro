---
import Tag from '../components/Tag.astro';
import Base from '../layouts/Base.astro';
import HeroCode from '../components/HeroCode.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardMarquee from '../components/CardMarquee.astro';
import SavingsCalc from '../components/SavingsCalc.astro';
import {
  getProjects,
  getServices,
  getSettings,
  getSite,
  isPlaceholder,
  localePath,
  publicFileExists,
  url,
  type Lang,
} from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const services = await getServices();
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
// The live, featured project with a screenshot gets a spotlight and the launch bar.
const spot = projects.find((p) => p.data.featured && p.data.link && p.data.image && publicFileExists(p.data.image));
const spotDomain = spot?.data.link?.replace(/^https?:\/\/|\/$/g, '');
// A lighter copy of the screenshot for phones, when one exists next to it (778×310: same proportions as the original).
const spotSmallPath = spot?.data.image?.replace(/\.webp$/, '-778.webp');
const spotSmall = spotSmallPath && spotSmallPath !== spot?.data.image && publicFileExists(spotSmallPath) ? spotSmallPath : undefined;
const r = t.about.reviews;
const quote = r.items.reduce((a, b) => (b.text.length > a.text.length ? b : a));
const en = await getSite('en');
const stack = [...new Set(t.about.skills.slice(0, 4).flatMap((g) => g.items))].filter(
  (item) => !/\p{Script=Arabic}/u.test(item),
);
const hasPhoto = publicFileExists(s.photo);
const photoWebp = s.photo.replace(/\.jpe?g$/i, '.webp');
const hasWebp = photoWebp !== s.photo && publicFileExists(photoWebp);
const photoSmall = photoWebp.replace(/\.webp$/, '-208.webp');
const hasSmall = publicFileExists(photoSmall);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.hero.name,
  alternateName: lang === 'ar' ? en.hero.name : (await getSite('ar')).hero.name,
  jobTitle: t.hero.title,
  description: t.hero.value,
  url: new URL(localePath(lang, '/'), Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Madinah',
    addressCountry: 'SA',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Yanbu Industrial College',
  },
  knowsAbout: ['C#', '.NET', 'SQL Server', 'Python', 'TypeScript', 'Business Analysis', 'Automation'],
  knowsLanguage: ['ar', 'en'],
  sameAs: [s.linkedin, s.github].filter((link) => !isPlaceholder(link)),
};
---

<Base
  lang={lang}
  path="/"
  title={t.meta.pages.home.title}
  description={t.meta.pages.home.description}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    {
      spot && (
        <div class="container-x relative pt-8 sm:pt-10">
          <a href={spot.data.link} target="_blank" rel="noopener noreferrer" class="launch-bar">
            <span class="launch-badge">
              <Icon name="sparkles" size={14} />
              {t.home.launch.badge}
            </span>
            <span class="launch-text">{t.home.launch.text}</span>
            <span class="launch-cta">
              {t.home.launch.cta}
              <bdi dir="ltr" class="launch-domain">{spotDomain}</bdi>
              <Icon name="external" size={15} />
            </span>
          </a>
        </div>
      )
    }
    <div
      class:list={[
        'container-x relative grid items-center gap-12 pb-10 lg:pb-14 xl:grid-cols-[1fr_1.1fr]',
        spot ? 'pt-10 sm:pt-12 lg:pt-16' : 'pt-16 sm:pt-20 lg:pt-28',
      ]}
    >
      <div>
        {
          hasPhoto && (
            <picture class="photo-ring mb-6 shadow-soft">
              {hasWebp && (
                <source
                  srcset={hasSmall ? `${url(photoSmall)} 208w, ${url(photoWebp)} 400w` : url(photoWebp)}
                  sizes="104px"
                  type="image/webp"
                />
              )}
              <img
                src={url(s.photo)}
                alt={t.about.photoAlt}
                width="104"
                height="104"
                fetchpriority="high"
                class="size-22 object-cover sm:size-26"
              />
            </picture>
          )
        }
        <div class="flex flex-wrap items-center gap-2">
          <p class="eyebrow chip-eyebrow"><span class="pulse-dot" aria-hidden="true"></span>{t.hero.title}</p>
          <a href={localePath(lang, '/request/')} class="available-pill">
            <span class="available-dot" aria-hidden="true"></span>
            {t.home.available}
          </a>
        </div>
        <h1 class="mt-3 text-4xl leading-tight font-bold text-text sm:text-5xl">
          <span class="name-underline"><span class="name-gradient">{t.hero.name}</span></span>
        </h1>
        <p class="mt-4 text-lg font-semibold text-gold-text sm:text-xl">
          {t.hero.rotatingLead}{' '}
          <span class="rotator text-accent" data-rotate={JSON.stringify(t.hero.rotating)}>{t.hero.rotating[0]}</span>
        </p>
        <p class="mt-4 text-base text-muted sm:text-lg">{t.hero.support}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localePath(lang, '/request/')} class="btn btn-primary">
            {t.hero.ctaPrimary}
            <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
          </a>
          <a href={localePath(lang, '/projects/')} class="btn btn-ghost">{t.hero.ctaSecondary}</a>
        </div>
      </div>
      <div class="hero-side relative min-w-0">
        <div class="float-soft hero-code-glow">
          <HeroCode label={t.hero.codeLabel} />
        </div>
        {
          t.hero.chips.map((chip, i) => (
            <div class={`hero-chip hidden sm:flex ${i === 0 ? 'hero-chip-a' : 'hero-chip-b'}`} aria-hidden="true">
              <span class="chip-icon">
                <Icon name={chip.icon} size={17} />
              </span>
              <span>
                <bdi dir="ltr">{chip.value}</bdi>
                <small>{chip.label}</small>
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="container-x relative pb-12 sm:pb-16">
      <p class="hero-statement reveal">{t.hero.value}</p>
    </div>
  </section>

  <!-- Stats -->
  <section aria-label={t.stats.label} class="band-glass border-y border-line">
    <dl class="stagger container-x grid grid-cols-2 gap-4 py-10 lg:grid-cols-4">
      {
        t.stats.items.map((item) => (
          <div class="stat-card reveal flex flex-col-reverse gap-1.5">
            <dt class="text-sm font-medium text-muted">{item.label}</dt>
            <dd class="flex items-center gap-3 text-3xl font-bold text-accent sm:text-4xl">
              {item.icon && (
                <span class="icon-badge size-12 rounded-xl">
                  <Icon name={item.icon} size={24} />
                </span>
              )}
              <bdi dir="ltr" data-count={item.value}>{item.value}</bdi>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Tech stack marquee (decorative; the full list is on the About page) -->
  <section class="marquee band-glass border-b border-line py-4" aria-label={t.hero.stackLabel}>
    <div class="marquee-track" dir="ltr">
      {
        [0, 1].map((copy) => (
          <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {stack.map((item) => (
              <Tag text={item} />
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  {
    spot && (
      <section class="container-x pt-20 sm:pt-24" aria-labelledby="home-spotlight">
        <div class="spotlight reveal">
          <div class="spotlight-media">
            <div class="browser-frame">
              <div class="browser-bar" aria-hidden="true">
                <span class="browser-dots"><i></i><i></i><i></i></span>
                <span class="browser-url" dir="ltr">
                  <Icon name="shield" size={12} />
                  {spotDomain}
                </span>
              </div>
              <img
                src={url(spot.data.image!)}
                srcset={spotSmall ? `${url(spotSmall)} 778w, ${url(spot.data.image!)} 1556w` : undefined}
                sizes="(min-width: 64rem) 36rem, 92vw"
                alt={t.home.spotlight.imageAlt}
                width={spot.data.imageSize?.[0]}
                height={spot.data.imageSize?.[1]}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="spotlight-live" aria-hidden="true">
              <span class="pulse-dot"></span>
              {t.projects.live}
            </span>
          </div>
          <div class="spotlight-body">
            <p class="eyebrow chip-eyebrow">
              <Icon name="star" size={14} />
              {t.home.spotlight.eyebrow}
            </p>
            <h2 id="home-spotlight" class="mt-4 text-2xl leading-snug font-bold text-text sm:text-3xl">
              {spot.data[lang].title}
              <span class="spotlight-tag">{t.home.spotlight.title}</span>
            </h2>
            <p class="mt-3 text-muted">{spot.data[lang].summary}</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {t.home.spotlight.points.map((pt) => (
                <li class="spotlight-point">
                  <span class="icon-badge size-9 rounded-lg">
                    <Icon name={pt.icon} size={18} />
                  </span>
                  <span>{pt.text}</span>
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href={spot.data.link} target="_blank" rel="noopener noreferrer" class="visit-btn visit-btn-lg">
                <Icon name="external" size={20} />
                {t.projects.visit}
                <span class="visit-domain" dir="ltr">{spotDomain}</span>
              </a>
              <a href={localePath(lang, `/projects/${spot.id}/`)} class="btn btn-ghost">
                {t.projects.viewCase}
                <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="container-x pt-20 sm:pt-24" aria-labelledby="home-services">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading id="home-services" icon="briefcase" title={t.home.servicesTitle} intro={t.home.servicesIntro} />
      <a
        href={localePath(lang, '/services/')}
        class="more-pill"
      >
        <span class="icon-badge size-8 rounded-lg"><Icon name="briefcase" size={16} /></span>
        {t.home.servicesMore}
        <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
      </a>
    </div>
  </section>
  <CardMarquee label={t.home.servicesTitle} dir={dir}>
    {
      services.map((service) => {
        const st = service.data[lang];
        return (
          <li class="cm-item cm-service card card-hover relative p-6">
            <span class="icon-badge draw size-11">
              <Icon name={service.data.icon} size={22} />
            </span>
            <h3 class="mt-4 text-lg leading-snug font-bold text-text">
              <a href={localePath(lang, `/services/#${service.id}`)} class="after:absolute after:inset-0">
                {st.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-muted">{st.summary}</p>
          </li>
        );
      })
    }
  </CardMarquee>

  <!-- Featured projects -->
  <section class="container-x pt-20 sm:pt-24" aria-labelledby="home-projects">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading id="home-projects" icon="folder" title={t.home.projectsTitle} intro={t.home.projectsIntro} />
      <a
        href={localePath(lang, '/projects/')}
        class="more-pill"
      >
        <span class="icon-badge size-8 rounded-lg"><Icon name="folder" size={16} /></span>
        {t.home.projectsMore}
        <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
      </a>
    </div>
  </section>
  <CardMarquee label={t.home.projectsTitle} dir={dir} reverse speed="slow" repeat={3}>
    {
      featured.map((project) => (
        <li class="cm-item cm-project">
          <ProjectCard project={project} lang={lang} />
        </li>
      ))
    }
  </CardMarquee>

  <!-- How I work -->
  <section class="container-x pt-20 sm:pt-24" aria-labelledby="home-rating">
    <div class="rating-spot reveal">
      <div class="rating-score">
        <span class="rating-num" dir="ltr" data-count={r.stats[0].value}>{r.stats[0].value}</span>
        <span class="rating-stars" role="img" aria-label={t.home.rating.starsLabel}>
          {[0, 1, 2, 3, 4].map((i) => <Icon name="star" size={22} class={`ico-still star-${i}`} />)}
        </span>
        <h2 id="home-rating" class="mt-2 font-bold text-text">{t.home.rating.title}</h2>
        <ul class="rating-stats">
          {r.stats.slice(1).map((st) => (
            <li>
              <bdi dir="ltr" data-count={st.value}>{st.value}</bdi>
              <small>{st.label}</small>
            </li>
          ))}
        </ul>
      </div>
      <figure class="rating-quote">
        <Icon name="quote" size={34} class="quote-mark" />
        <blockquote dir="auto">{quote.text}</blockquote>
        <figcaption>
          <span dir="auto">{quote.name}</span> · {quote.date}
        </figcaption>
        <a href={localePath(lang, '/about/#reviews')} class="more-pill mt-5">
          {t.home.rating.more}
          <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
        </a>
      </figure>
    </div>
  </section>

  <section class="container-x pt-20 sm:pt-24" aria-labelledby="home-process">
    <SectionHeading id="home-process" icon="flow" title={t.home.processTitle} />
  </section>
  <CardMarquee label={t.home.processTitle} dir={dir} repeat={3}>
    {
      t.home.process.map((step, i) => (
        <li class="cm-item cm-step card card-hover step-card flex items-start gap-3.5 p-4">
          <span class="step-num" dir="ltr">{String(i + 1).padStart(2, '0')}</span>
          <div class="min-w-0">
            <h3 class="font-bold text-text">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.text}</p>
          </div>
        </li>
      ))
    }
  </CardMarquee>

  <SavingsCalc lang={lang} />

  <!-- Closing CTA -->
  <section class="container-x pt-20 sm:pt-24">
    <div
      class="cta-banner reveal relative overflow-hidden rounded-3xl px-6 py-14 text-center text-white sm:px-12"
    >
      <span class="cta-orb cta-orb-a" aria-hidden="true"></span>
      <span class="cta-orb cta-orb-b" aria-hidden="true"></span>
      <span class="cta-icon mx-auto mb-5" aria-hidden="true"><Icon name="send" size={26} /></span>
      <p class="relative mx-auto max-w-2xl text-2xl leading-relaxed font-bold sm:text-3xl">{t.home.cta}</p>
      <div class="relative mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={localePath(lang, '/request/')} class="btn cta-btn cta-pulse text-lg">
          <Icon name="send" size={18} />
          {t.nav.request}
        </a>
        <a href={localePath(lang, '/contact/')} class="btn cta-btn-ghost text-lg">
          {t.home.ctaButton}
          <Icon name="arrow" size={18} class="rtl:-scale-x-100" />
        </a>
        {
          s.booking && (
            <a href={s.booking} target="_blank" rel="noopener noreferrer" class="btn cta-btn-ghost text-lg" data-booking>
              <Icon name="calendar" size={18} />
              {t.contact.booking}
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>
