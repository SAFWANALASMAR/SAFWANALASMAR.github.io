---
import Icon from './Icon.astro';
import { emailParts, getSettings, getSite, isPlaceholder, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const year = new Date().getFullYear();
const mail = emailParts(s.email);
---

<footer class="site-footer mt-24">
  <div
    class="container-x flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <a href={localePath(lang, '/')} class="brand flex items-center gap-3 font-bold text-text"><span class="brand-mark" aria-hidden="true"><span class="brand-core"><Icon name="code" size={19} /></span></span><span class="brand-name text-lg">{t.hero.name}</span></a>
      <p class="mt-1 text-sm text-muted">{t.footer.tagline}</p>
    </div>
    <ul class="flex items-center gap-2">
      {
        !isPlaceholder(s.email) && (
          <li>
            <a
              href={localePath(lang, '/contact/')}
              data-u={mail.u}
              data-d={mail.d}
              class="ctrl-btn size-11 text-muted"
              aria-label={t.contact.emailLabel}
            >
              <Icon name="mail" />
            </a>
          </li>
        )
      }
      <li>
        <a
          href={s.linkedin}
          rel="me noopener noreferrer"
          target="_blank"
          class="ctrl-btn size-11 text-muted"
          aria-label={t.contact.linkedinLabel}
        >
          <Icon name="linkedin" />
        </a>
      </li>
      {
        !isPlaceholder(s.github) && (
          <li>
            <a
              href={s.github}
              rel="me noopener noreferrer"
              target="_blank"
              class="ctrl-btn size-11 text-muted"
              aria-label={t.contact.githubLabel}
            >
              <Icon name="github" />
            </a>
          </li>
        )
      }
    </ul>
  </div>
  <div class="container-x border-t border-line/60 py-5 text-xs text-muted">
    © <span dir="ltr">{year}</span>{' '}{t.hero.name}. {t.footer.rights}
  </div>
</footer>
