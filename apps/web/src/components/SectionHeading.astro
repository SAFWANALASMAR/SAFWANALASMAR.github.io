---
import SectionTitle from './SectionTitle.astro';
import type { IconName } from './Icon.astro';

interface Props {
  title: string;
  intro?: string;
  id?: string;
  as?: 'h1' | 'h2';
  icon?: IconName;
}
const { title, intro, id, as = 'h2', icon } = Astro.props;
---

<div class="reveal max-w-2xl">
  <SectionTitle title={title} id={id} as={as} icon={icon} />
  {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
</div>
