---
import Icon from './Icon.astro';
import { getSite, localePath, otherLang, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = await getSite(lang);
const other = otherLang(lang);

const links = [
  { path: '/', label: t.nav.home, icon: 'home' },
  { path: '/services/', label: t.nav.services, icon: 'briefcase' },
  { path: '/projects/', label: t.nav.projects, icon: 'folder' },
  { path: '/about/', label: t.nav.about, icon: 'user' },
  { path: '/contact/', label: t.nav.contact, icon: 'mail' },
] as const;

const isActive = (linkPath: string) =>
  linkPath === '/' ? path === '/' : path.startsWith(linkPath);
---

<header class="site-header sticky top-0 z-40 px-2 pt-2 sm:px-4 sm:pt-3">
  <div class="header-shell mx-auto flex h-[4.5rem] max-w-6xl items-center justify-between gap-3 ps-2.5 pe-2 sm:ps-3">
    <div class="scroll-progress" aria-hidden="true"></div>

    <a href={localePath(lang, '/')} class="brand flex min-w-0 items-center gap-3" aria-label={t.hero.name}>
      <span class="brand-mark" aria-hidden="true">
        <span class="brand-core"><Icon name="code" size={19} /></span>
      </span>
      <span class="hidden min-w-0 flex-col leading-tight min-[360px]:flex">
        <span class="brand-name truncate text-base font-bold sm:text-xl">{t.hero.name}</span>
        <span class="hidden truncate text-sm text-muted 2xl:block">{t.hero.title}</span>
      </span>
    </a>

    <nav aria-label={t.nav.primary} class="hidden lg:block">
      <ul class="nav-pill">
        {
          links.map((link) => (
            <li>
              <a
                href={localePath(lang, link.path)}
                aria-current={isActive(link.path) ? 'page' : undefined}
                class="nav-link"
              >
                <Icon name={link.icon} size={18} class="hidden xl:block" />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={localePath(lang, '/request/')}
        aria-current={isActive('/request/') ? 'page' : undefined}
        class="request-cta hidden whitespace-nowrap md:inline-flex"
      >
        <Icon name="send" size={17} />
        {t.nav.request}
      </a>
      <a
        href={localePath(other, path)}
        lang={other}
        hreflang={other}
        aria-label={t.nav.switchLangLabel}
        class="ctrl-btn h-10 gap-1.5 px-3 text-sm font-semibold sm:h-11 sm:px-4 sm:text-base"
      >
        <Icon name="globe" size={16} />
        <span class="max-[420px]:sr-only">{t.nav.switchLang}</span>
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t.nav.themeToggle}
        aria-pressed="false"
        class="ctrl-btn theme-btn size-10 sm:size-11"
      >
        <Icon name="moon" class="dark:hidden" />
        <Icon name="sun" class="hidden dark:block" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
        class="ctrl-btn size-10 sm:size-11 lg:hidden"
      >
        <Icon name="menu" class="menu-open-icon" />
        <Icon name="close" class="menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t.nav.primary} class="mobile-panel mx-auto mt-2 hidden max-w-6xl lg:hidden">
    <ul class="flex flex-col gap-1 p-2">
      <li>
        <a href={localePath(lang, '/request/')} class="mobile-link mobile-request">
          <span class="icon-badge size-9">
            <Icon name="send" size={18} />
          </span>
          <span class="flex-1">{t.nav.request}</span>
          <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
        </a>
      </li>
      {
        links.map((link) => (
          <li>
            <a
              href={localePath(lang, link.path)}
              aria-current={isActive(link.path) ? 'page' : undefined}
              class="mobile-link"
            >
              <span class="icon-badge size-9">
                <Icon name={link.icon} size={18} />
              </span>
              <span class="flex-1">{link.label}</span>
              <Icon name="arrow" size={16} class="text-muted rtl:-scale-x-100" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

{
  /* Phones: the header has no room for the button, so it floats above the page (not on the request page itself). */
  !path.startsWith('/request') && (
    <a href={localePath(lang, '/request/')} class="request-fab md:hidden">
      <Icon name="send" size={18} />
      {t.nav.request}
    </a>
  )
}

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    toggle.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
  });

  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => themeBtn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  sync();
  themeBtn?.addEventListener('click', () => {
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    sync();
  });
</script>
