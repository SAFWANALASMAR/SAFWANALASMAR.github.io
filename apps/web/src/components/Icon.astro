export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;

// Every icon has a small looping motion (see .ico in global.css). Menu and close stay still: they are controls.
const motions: Partial<Record<IconName, string>> = {
  arrow: 'nudge-x', external: 'nudge-x', send: 'fly',
  download: 'nudge-y', cloud: 'float', mail: 'float', cap: 'float', bot: 'float',
  heart: 'beat', nonprofit: 'beat',
  sparkles: 'spin', sun: 'spin', globe: 'spin',
  briefcase: 'swing', award: 'swing', moon: 'swing', teach: 'swing', key: 'swing', lock: 'swing', cart: 'swing', home: 'float', user: 'float', utensils: 'swing', car: 'nudge-x', droplet: 'beat', cake: 'twinkle', book: 'swing', mosque: 'float',
  star: 'twinkle', bolt: 'twinkle', shield: 'twinkle', check: 'twinkle',
  clock: 'swing', help: 'swing', install: 'nudge-y',
  menu: 'still', close: 'still', plus: 'still',
};
const motion = motions[name] ?? 'breathe';
// Spread the phase so neighbouring icons don't pulse in unison (a class, not a style attribute: the CSP forbids those).
const phase = [...name].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % 6;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={`ico ico-${motion} ico-p${phase} ${className}`}
  set:html={paths[name]}
/>
