---
import Tag from './Tag.astro';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getSite, localePath, type Lang } from '../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { project, lang, headingLevel: Heading = 'h3' } = Astro.props;
const t = await getSite(lang);
const p = project.data;
const text = p[lang];
const typeIcon = {
  'web-system': 'web',
  automation: 'flow',
  'web-app': 'layout',
  'digital-transformation': 'nonprofit',
  'business-analysis': 'analysis',
} as const;
---

<article class="card card-hover project-card reveal relative flex h-full flex-col p-6" data-tilt>
  <div class="mb-5 flex items-center justify-between gap-3">
    <span class="icon-badge size-11 rounded-xl">
      <Icon name={typeIcon[p.type]} size={22} />
    </span>
    <div class="flex flex-wrap items-center justify-end gap-1.5 text-xs font-semibold">
      {
        p.status === 'in-progress' && (
          <span class="chip chip-live">
            <span class="pulse-dot" aria-hidden="true" />
            {t.projects.inProgress}
          </span>
        )
      }
      {
        p.link && (
          <span class="chip chip-live">
            <span class="pulse-dot" aria-hidden="true" />
            {t.projects.live}
          </span>
        )
      }
      <span class="chip">{t.projects.types[p.type]}</span>
      <span class="chip font-mono" dir="ltr">{p.year}</span>
    </div>
  </div>
  <Heading class="text-xl leading-snug font-bold text-text">
    <a href={localePath(lang, `/projects/${project.id}/`)} class="after:absolute after:inset-0">
      {text.title}
    </a>
  </Heading>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted">{text.summary}</p>
  <ul class="mt-5 flex flex-wrap gap-1.5">
    {p.tags.map((tag) => <Tag text={tag} />)}
  </ul>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <span class="case-link">
      {t.projects.viewCase}
      <Icon name="arrow" size={16} class="rtl:-scale-x-100" />
    </span>
    {
      p.link && (
        <a href={p.link} target="_blank" rel="noopener noreferrer" class="visit-btn relative z-10">
          <Icon name="external" size={16} />
          {t.projects.visit}
          <span class="visit-domain" dir="ltr">{p.link.replace(/^https?:\/\/|\/$/g, '')}</span>
        </a>
      )
    }
  </div>
</article>
