---
// Link-preview cards (1200×630) for every page and project, in both languages.
// Rendered to public/og/*.png by `npm run og`. Not linked anywhere and not indexed.
import '../styles/global.css';
import { getProjects, getSettings, getSite, publicFileExists, url, type Lang } from '../lib/i18n';

const s = await getSettings();
const projects = await getProjects();
const photo = s.photo.replace(/\.jpe?g$/i, '.webp');
const hasPhoto = publicFileExists(photo);
const cards: { file: string; lang: Lang; kicker: string; title: string; text: string; live?: string }[] = [];
for (const lang of ['ar', 'en'] as const) {
  const t = await getSite(lang);
  const pages = ['home', 'services', 'projects', 'about', 'contact', 'request'] as const;
  for (const key of pages) {
    const meta = t.meta.pages[key];
    cards.push({
      file: `${lang}-${key}`,
      lang,
      kicker: key === 'home' ? t.hero.title : t.nav[key],
      title: key === 'home' ? t.hero.name : meta.title.split(' — ')[0],
      text: meta.description,
    });
  }
  for (const p of projects) {
    cards.push({
      file: `${lang}-projects-${p.id}`,
      lang,
      kicker: t.projects.types[p.data.type],
      title: p.data[lang].title,
      text: p.data[lang].summary,
      live: p.data.link ? `${t.projects.live} · ${p.data.link.replace(/^https?:\/\/|\/$/g, '')}` : undefined,
    });
  }
}
const ar = await getSite('ar');
const en = await getSite('en');
---

<html lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og</title>
  </head>
  <body class="og-body">
    {
      cards.map((c) => (
        <div class="og-card" data-og={c.file} lang={c.lang} dir={c.lang === 'ar' ? 'rtl' : 'ltr'}>
          <div class="og-grid" />
          <div class="og-glow" />
          <div class="og-main">
            <p class="og-kicker">{c.kicker}</p>
            <h1 class="og-title">{c.title}</h1>
            <p class="og-text">{c.text}</p>
            {c.live && <p class="og-live"><span class="og-dot" />{c.live}</p>}
          </div>
          <div class="og-foot">
            <div class="og-person">
              {hasPhoto && <img src={url(photo)} alt="" width="84" height="84" />}
              <div>
                <strong>{c.lang === 'ar' ? ar.hero.name : en.hero.name}</strong>
                <span>{c.lang === 'ar' ? ar.hero.title : en.hero.title}</span>
              </div>
            </div>
            <span class="og-domain" dir="ltr">safwanalasmar.github.io</span>
          </div>
        </div>
      ))
    }
  </body>
</html>

<style>
  .og-body { margin: 0; background: #06262a; }
  .og-card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 64px 72px;
    box-sizing: border-box;
    color: #fff;
    background: linear-gradient(135deg, #062e33 0%, #0b5a5f 55%, #0e7378 100%);
    font-family: var(--font-ar);
  }
  .og-card[lang='en'] { font-family: var(--font-en); }
  .og-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .og-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    inset-inline-end: -180px;
    top: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(246 215 126 / 0.35), transparent 65%);
  }
  .og-main, .og-foot { position: relative; }
  .og-kicker {
    display: inline-block;
    margin: 0;
    padding: 8px 22px;
    border-radius: 999px;
    font-size: 26px;
    font-weight: 700;
    color: #1a1405;
    background: linear-gradient(135deg, #f6d77e, #d9a521);
  }
  .og-title { margin: 28px 0 0; font-size: 68px; line-height: 1.2; font-weight: 800; }
  .og-text {
    margin: 18px 0 0;
    max-width: 960px;
    font-size: 30px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.82);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .og-live { display: inline-flex; align-items: center; gap: 12px; margin: 22px 0 0; font-size: 26px; font-weight: 700; color: #86efac; }
  .og-dot { width: 14px; height: 14px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 6px rgb(34 197 94 / 0.25); }
  .og-foot { display: flex; align-items: center; justify-content: space-between; }
  .og-person { display: flex; align-items: center; gap: 20px; }
  .og-person img { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 4px solid #f6d77e; }
  .og-person strong { display: block; font-size: 30px; }
  .og-person span { font-size: 22px; color: rgb(255 255 255 / 0.75); }
  .og-domain { font-family: var(--font-mono); font-size: 24px; color: #f6d77e; }
</style>
