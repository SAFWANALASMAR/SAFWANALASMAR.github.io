// الواجهة: صفحات ثابتة من dist/، وأي طلب يبدأ بـ /api/ يُمرَّر إلى عامل الخادم (safwan-api).
// The web app: static pages from dist/; anything under /api/ is forwarded to the API Worker.
// Security headers for static pages live in public/_headers.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "safwan-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "API", "service": "safwan-api" }]
}
