// خادم الموقع: لا يُفتح للعموم مباشرة، ويصله عامل الواجهة فقط عبر ربط الخدمة (services).
// The site API. Not public on its own: only the web Worker reaches it, through a service binding.
// Secrets (set once with `npx wrangler secret put <NAME>`, never committed):
//   TURNSTILE_SECRET  — Cloudflare Turnstile secret key
//   RESEND_API_KEY    — Resend API key used to send the contact email
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "safwan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "MAIL_TO": "safwan.asmar10@gmail.com",
    "MAIL_FROM": "Safwan Site <onboarding@resend.dev>"
  }
}
