---
import Base from '../layouts/Base.astro';
import { getSite, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const other = lang === 'ar' ? await getSite('en') : null;
---

<Base
  lang={lang}
  path="/"
  title={t.meta.pages.notFound.title}
  description={t.meta.pages.notFound.description}
  noindex
>
  <section class="container-x py-24 text-center sm:py-32">
    <p class="font-mono text-6xl font-bold text-accent" aria-hidden="true">404</p>
    <h1 class="mt-4 text-3xl font-bold text-text">{t.notFound.title}</h1>
    <p class="mt-3 text-muted">{t.notFound.text}</p>
    <a href={localePath(lang, '/')} class="btn btn-primary mt-8">{t.notFound.back}</a>
    {
      other && (
        <p class="mt-6 text-sm text-muted" lang="en" dir="ltr">
          {other.notFound.title} —{' '}
          <a href={localePath('en', '/')} class="font-semibold text-accent hover:underline">
            {other.notFound.back}
          </a>
        </p>
      )
    }
  </section>
</Base>
