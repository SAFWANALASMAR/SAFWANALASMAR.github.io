---
import Base from '../layouts/Base.astro';
import { getSettings, getSite, publicFileExists, tagClass, url, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const s = await getSettings();
const a = t.about;
const hasPhoto = publicFileExists(s.photo);
---

<Base
  lang={lang}
  path="/about/"
  title={t.meta.pages.about.title}
  description={t.meta.pages.about.description}
>
  <section class="container-x pt-14 sm:pt-20">
    <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
      {
        hasPhoto ? (
          <img
            src={url(s.photo)}
            alt={a.photoAlt}
            width="176"
            height="176"
            class="size-36 rounded-full border-4 border-surface object-cover shadow-soft sm:size-44"
          />
        ) : (
          <div
            class="grid size-36 place-items-center rounded-full bg-accent text-4xl font-bold text-on-accent shadow-soft sm:size-44 sm:text-5xl"
            role="img"
            aria-label={a.photoAlt}
          >
            <span aria-hidden="true">{a.initials}</span>
          </div>
        )
      }
      <div class="max-w-3xl">
        <h1 class="text-3xl font-bold text-text sm:text-4xl">{a.title}</h1>
        <p class="mt-5 text-lg text-text">{a.bio}</p>
      </div>
    </div>
  </section>

  <div class="container-x mt-16 grid gap-16 lg:grid-cols-2">
    <!-- Timeline -->
    <section aria-labelledby="timeline">
      <h2 id="timeline" class="text-2xl font-bold text-text">{a.timelineTitle}</h2>
      <ol class="mt-8 space-y-8 border-s-2 border-line ps-6">
        {
          a.timeline.map((item) => (
            <li class="reveal relative">
              <span
                class="absolute -start-[1.95rem] top-1.5 size-3.5 rounded-full border-2 border-bg bg-accent"
                aria-hidden="true"
              />
              <p class="text-sm font-medium text-accent">{item.period}</p>
              <h3 class="mt-1 font-bold text-text">{item.org}</h3>
              <p class="mt-1 text-sm text-muted">{item.role}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="space-y-16">
      <!-- Education -->
      <section aria-labelledby="education">
        <h2 id="education" class="text-2xl font-bold text-text">{a.educationTitle}</h2>
        <ul class="mt-8 space-y-4">
          {
            a.education.map((item) => (
              <li class="card reveal flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 p-5">
                <div>
                  <h3 class="font-bold text-text">{item.title}</h3>
                  {item.org && <p class="mt-0.5 text-sm text-muted">{item.org}</p>}
                </div>
                <span class="text-sm font-medium text-accent">{item.date}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Volunteering -->
      <section aria-labelledby="volunteer">
        <h2 id="volunteer" class="text-2xl font-bold text-text">{a.volunteerTitle}</h2>
        <p class="reveal mt-4 text-muted">{a.volunteer}</p>
      </section>
    </div>
  </div>

  <!-- Skills -->
  <section class="container-x mt-16" aria-labelledby="skills">
    <h2 id="skills" class="text-2xl font-bold text-text">{a.skillsTitle}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        a.skills.map((group) => (
          <div class="card reveal p-6">
            <h3 class="font-bold text-text">{group.category}</h3>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class={tagClass(item)}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
