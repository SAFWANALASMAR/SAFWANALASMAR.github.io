{
  "name": "safwan-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @safwan/web",
    "dev:api": "npm run dev -w @safwan/api",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @safwan/web",
    "e2e": "npm run e2e -w @safwan/web",
    "deploy:api": "npm run deploy -w @safwan/api",
    "deploy:web": "npm run deploy:cf -w @safwan/web"
  }
}
